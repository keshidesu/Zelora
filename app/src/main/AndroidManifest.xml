<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Zelora">

        <activity
            android:name=".ui.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.SignUpActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.MainActivity"
            android:exported="false" />
        <activity
            android:name=".ui.ProductDetailActivity"
            android:exported="false" />
        <activity
            android:name=".ui.OrdersActivity"
            android:exported="false" />
        <activity
            android:name=".ui.AccountSettingsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.InfoActivity"
            android:exported="false" />
        <activity
            android:name=".ui.SellerActivity"
            android:exported="false" />
        <activity
            android:name=".ui.AdminActivity"
            android:exported="false" />
        <activity
            android:name=".ui.RiderActivity"
            android:exported="false" />
        <activity
            android:name=".ui.DeliveryActivity"
            android:exported="false" />
    </application>

</manifest>
