<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <include layout="@layout/view_toolbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="32dp">

        <TextView
            style="@style/Text.SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="Profile"
            android:textSize="19sp" />

        <TextView
            style="@style/FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="6dp"
            android:text="Full name" />

        <EditText
            android:id="@+id/etName"
            style="@style/Field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Full name"
            android:inputType="textPersonName|textCapWords" />

        <TextView
            style="@style/FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="6dp"
            android:text="Email (cannot be changed)" />

        <EditText
            android:id="@+id/etEmail"
            style="@style/Field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Email"
            android:inputType="textEmailAddress"
            android:enabled="false" />

        <TextView
            style="@style/FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="6dp"
            android:text="Mobile number" />

        <EditText
            android:id="@+id/etPhone"
            style="@style/Field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="09XXXXXXXXX"
            android:inputType="phone" />

        <TextView
            android:id="@+id/btnSaveProfile"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_btn_dark"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/inter_semibold"
            android:gravity="center"
            android:text="Save Profile"
            android:textColor="@color/white"
            android:textSize="15sp" />

        <TextView
            style="@style/Text.SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="Shipping address"
            android:textSize="19sp" />

        <TextView
            style="@style/FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="6dp"
            android:text="Recipient name" />

        <EditText
            android:id="@+id/etRecipient"
            style="@style/Field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Recipient name"
            android:inputType="textPersonName|textCapWords" />

        <TextView
            style="@style/FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="6dp"
            android:text="Complete address" />

        <EditText
            android:id="@+id/etAddress"
            style="@style/Field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="House no., street, city, province"
            android:inputType="textPostalAddress" />

        <TextView
            android:id="@+id/btnSaveAddress"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_btn_dark"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/inter_semibold"
            android:gravity="center"
            android:text="Save Address"
            android:textColor="@color/white"
            android:textSize="15sp" />

        <TextView
            style="@style/Text.SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="Change password"
            android:textSize="19sp" />

        <TextView
            style="@style/FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="6dp"
            android:text="Current password" />

        <EditText
            android:id="@+id/etCurrent"
            style="@style/Field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Current password"
            android:inputType="textPassword" />

        <TextView
            style="@style/FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="6dp"
            android:text="New password" />

        <EditText
            android:id="@+id/etNew"
            style="@style/Field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="At least 8 characters, letters and numbers"
            android:inputType="textPassword" />

        <TextView
            style="@style/FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="6dp"
            android:text="Confirm new password" />

        <EditText
            android:id="@+id/etConfirm"
            style="@style/Field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Repeat new password"
            android:inputType="textPassword" />

        <TextView
            android:id="@+id/btnChangePassword"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_btn_dark"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/inter_semibold"
            android:gravity="center"
            android:text="Update Password"
            android:textColor="@color/white"
            android:textSize="15sp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
