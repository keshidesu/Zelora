<?xml version="1.0" encoding="utf-8"?>
<!--
    LOGIN screen. Every number below was measured from the mockup (390 x 844 frame,
    1 mockup px = 1 dp, status bar not included).
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="26dp"
        android:paddingTop="40dp"
        android:paddingEnd="26dp"
        android:paddingBottom="24dp">

        <ImageView
            android:layout_width="92dp"
            android:layout_height="92dp"
            android:layout_marginBottom="14dp"
            android:contentDescription="Zelora logo"
            android:src="@drawable/zelora_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_bold"
            android:includeFontPadding="false"
            android:text="Welcome!"
            android:textColor="@color/brown"
            android:textSize="41sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:fontFamily="@font/inter_regular"
            android:gravity="center"
            android:includeFontPadding="false"
            android:lineSpacingExtra="3dp"
            android:text="Log in to continue your journey\nwith Zelora."
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <!-- Email field -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="53dp"
            android:layout_marginTop="26dp"
            android:background="@drawable/bg_input"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_mail"
                app:tint="@color/text_primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_semibold"
                    android:includeFontPadding="false"
                    android:text="Email Address"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:autofillHints="emailAddress"
                    android:background="@null"
                    android:fontFamily="@font/inter_regular"
                    android:hint="hello@zelora.com"
                    android:includeFontPadding="false"
                    android:inputType="textEmailAddress"
                    android:maxLines="1"
                    android:padding="0dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Password field -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="53dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="4dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_lock"
                app:tint="@color/text_primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_semibold"
                    android:includeFontPadding="false"
                    android:text="Password"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:autofillHints="password"
                    android:background="@null"
                    android:fontFamily="@font/inter_regular"
                    android:hint="••••••••"
                    android:includeFontPadding="false"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:padding="0dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnTogglePassword"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="Show or hide password"
                android:padding="13dp"
                android:src="@drawable/ic_eye_off"
                app:tint="@color/text_secondary" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvForgot"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="end"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/inter_semibold"
            android:gravity="center_vertical"
            android:text="@string/forgot_password"
            android:textColor="@color/text_primary"
            android:textSize="11sp" />

        <!-- Log in button (soft brown shadow like the mockup) -->
        <LinearLayout
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_btn_primary"
            android:clickable="true"
            android:elevation="6dp"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:outlineAmbientShadowColor="@color/btn_primary"
            android:outlineSpotShadowColor="@color/btn_primary"
            tools:targetApi="p">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semibold"
                android:text="Log in"
                android:textColor="@color/white"
                android:textSize="15sp" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_arrow_forward"
                app:tint="@color/white" />
        </LinearLayout>

        <!-- OR CONTINUE WITH -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/stroke" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:fontFamily="@font/inter_regular"
                android:includeFontPadding="false"
                android:text="OR CONTINUE WITH"
                android:textColor="@color/text_secondary"
                android:textSize="8sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/stroke" />
        </LinearLayout>

        <!-- Social circles: 44dp, 60dp between centres -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnGoogle"
                style="@style/SocialCircle"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="Continue with Google"
                android:fontFamily="@font/inter_bold"
                android:includeFontPadding="false"
                android:text="G"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <FrameLayout
                android:id="@+id/btnApple"
                style="@style/SocialCircle"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:contentDescription="Continue with Apple">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_apple"
                    app:tint="@color/text_primary" />
            </FrameLayout>

            <TextView
                android:id="@+id/btnFacebook"
                style="@style/SocialCircle"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="Continue with Facebook"
                android:fontFamily="serif"
                android:includeFontPadding="false"
                android:text="f"
                android:textColor="@color/text_primary"
                android:textSize="19sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvGoSignUp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/inter_regular"
            android:gravity="center"
            android:minHeight="40dp"
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />
    </LinearLayout>
</ScrollView>
