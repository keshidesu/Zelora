<?xml version="1.0" encoding="utf-8"?>
<!-- Seller and Rider home: header (menu, ZELORA, bell) + one page + bottom navigation -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/shellHeader"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/btnMenu"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_vertical|start"
            android:contentDescription="Menu"
            android:padding="8dp"
            android:src="@drawable/ic_menu"
            app:tint="@color/text_dark" />

        <TextView
            android:id="@+id/tvShellTitle"
            style="@style/Text.Heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:includeFontPadding="false"
            android:text="ZELORA"
            android:textColor="@color/text_dark"
            android:textSize="18sp" />

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_vertical|end">

            <ImageView
                android:id="@+id/btnBell"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="Notifications"
                android:padding="8dp"
                android:src="@drawable/ic_bell"
                app:tint="@color/brown" />

            <View
                android:id="@+id/bellDot"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="7dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_cart_badge"
                android:visibility="gone" />
        </FrameLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/shellContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/shellNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
