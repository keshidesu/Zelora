<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Zelora" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/brown</item>
        <item name="colorPrimaryVariant">@color/brown_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/orange</item>
        <item name="colorSurface">@color/surface</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="fontFamily">@font/inter</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.Zelora.BottomSheet</item>
        <item name="bottomNavigationStyle">@style/Widget.Zelora.BottomNav</item>
    </style>

    <!-- Checkout sheet: cream-white, 28dp rounded top corners, scrim like the mockup -->
    <style name="ThemeOverlay.Zelora.BottomSheet" parent="ThemeOverlay.MaterialComponents.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Zelora.BottomSheet</item>
        <item name="android:navigationBarColor">@color/sheet</item>
    </style>
    <style name="Widget.Zelora.BottomSheet" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="backgroundTint">@color/sheet</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.Zelora.Sheet</item>
    </style>
    <style name="ShapeAppearanceOverlay.Zelora.Sheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- Bottom navigation: 9sp labels, selected = bold brown, others = soft brown-grey -->
    <style name="Widget.Zelora.BottomNav" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:background">@color/surface</item>
        <item name="backgroundTint">@color/surface</item>
        <item name="elevation">0dp</item>
        <item name="itemIconTint">@color/nav_tint</item>
        <item name="itemTextColor">@color/nav_tint</item>
        <item name="itemIconSize">22dp</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.Zelora.NavActive</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.Zelora.NavInactive</item>
    </style>
    <style name="TextAppearance.Zelora.NavActive" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">9sp</item>
        <item name="android:fontFamily">@font/inter_bold</item>
    </style>
    <style name="TextAppearance.Zelora.NavInactive" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">9sp</item>
        <item name="android:fontFamily">@font/inter_regular</item>
    </style>

    <!-- Reusable text styles -->
    <style name="Text.Heading" parent="">
        <item name="android:fontFamily">@font/inter_bold</item>
        <item name="android:textColor">@color/brown_dark</item>
    </style>
    <style name="Text.Body" parent="">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="Text.Label" parent="">
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="Text.SectionTitle" parent="">
        <item name="android:fontFamily">@font/inter_bold</item>
        <item name="android:textColor">@color/brown</item>
        <item name="android:textSize">17sp</item>
    </style>
    <!-- The checkout sheet headings use Bricolage Grotesque in the mockup -->
    <style name="Text.Sheet" parent="">
        <item name="android:fontFamily">@font/bricolage_bold</item>
        <item name="android:textColor">@color/brown</item>
    </style>
</resources>
