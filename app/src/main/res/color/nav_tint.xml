<?xml version="1.0" encoding="utf-8"?>
<!-- In the mockup every nav item is the same brown; the selected tab is shown by its bold label.
     Change the second color if you want inactive tabs to look lighter. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true" android:color="@color/text_value" />
    <item android:color="@color/text_value" />
</selector>
