B;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="405" y="491" width="142" height="46" as="geometry"/></mxCell><mxCell id="c6" value="Out for Delivery&#xa;picked_up = 0, then 1" style="rounded=1;arcSize=18;whiteSpace=wrap;html=0;fontSize=12;fontColor=#2C1A0E;fillColor=#F7F1E8;strokeColor=#67331B;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="214" y="615" width="162" height="46" as="geometry"/></mxCell><mxCell id="c7" value="Delivered&#xa;COD becomes PAID" style="rounded=1;arcSize=18;whiteSpace=wrap;html=0;fontSize=12;fontColor=white;fillColor=#4B2215;strokeColor=#67331B;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="217" y="739" width="156" height="46" as="geometry"/></mxCell><mxCell id="c8" value="Cancelled&#xa;stock restored, voucher returned,&#xa;payment REFUNDED / CANCELLED" style="rounded=1;arcSize=18;whiteSpace=wrap;html=0;fontSize=12;fontColor=#2C1A0E;fillColor=#F2E2D8;strokeColor=#67331B;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="566" y="365" width="249" height="60" as="geometry"/></mxCell><mxCell id="c9" value="Dispute: Open&#xa;(customer reports a problem)" style="rounded=1;arcSize=18;whiteSpace=wrap;html=0;fontSize=12;fontColor=#2C1A0E;fillColor=#F0DFC8;strokeColor=#67331B;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="553" y="615" width="213" height="46" as="geometry"/></mxCell><mxCell id="c10" value="Resolved (optional refund)&#xa;or Rejected, with admin note" style="rounded=1;arcSize=18;whiteSpace=wrap;html=0;fontSize=12;fontColor=#2C1A0E;fillColor=#F0DFC8;strokeColor=#67331B;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="555" y="739" width="208" height="46" as="geometry"/></mxCell><mxCell id="c11" value="When the customer opens the app, each new status shows a local notification" style="shape=note;align=left;spacingLeft=6;whiteSpace=wrap;html=0;fontSize=12;fontColor=#2C1A0E;fillColor=#F0DFC8;strokeColor=#67331B;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="840" width="510" height="36" 